# Copy to .env.local. Never commit real values.

# Postgres (Neon via the Vercel Marketplace; `vercel env pull .env.local` fills this)
DATABASE_URL=

# Single-user password gate
APP_PASSWORD=
SESSION_SECRET=

# Secret header for /api/tick and /api/digest
CRON_SECRET=

# Data source: "fixture" (no keys needed) or "apify"
REDDIT_SOURCE=fixture
APIFY_TOKEN=

# Claude
ANTHROPIC_API_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=
